# RSV360 Staging Environment Variables
# Copy this file to .env.staging and fill in your values

# ============================================
# DATABASE CONFIGURATION
# ============================================
POSTGRES_USER=rsv360_staging
POSTGRES_PASSWORD=your_secure_staging_postgres_password_here
POSTGRES_DB=rsv360_staging_db
DATABASE_URL=postgresql://rsv360_staging:your_secure_staging_postgres_password_here@postgres:5432/rsv360_staging_db

# ============================================
# REDIS CONFIGURATION
# ============================================
REDIS_PASSWORD=your_staging_redis_password_here
REDIS_URL=redis://:your_staging_redis_password_here@redis:6379

# ============================================
# JWT CONFIGURATION
# ============================================
JWT_SECRET=your_staging_jwt_secret_here_minimum_32_characters

# ============================================
# FRONTEND CONFIGURATION
# ============================================
NEXT_PUBLIC_API_URL=http://staging.rsv360.com/api/v1
NEXT_PUBLIC_BACKEND_URL=http://staging.rsv360.com

# ============================================
# MONITORING CONFIGURATION
# ============================================
GRAFANA_ADMIN_PASSWORD=your_staging_grafana_password

# ============================================
# DEPLOYMENT CONFIGURATION
# ============================================
NODE_ENV=staging
PORT=3002