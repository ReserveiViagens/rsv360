# RSV360 Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit real secrets here.
# To use locally:
#   cp .env.example .env
# For docker compose, see the root docker-compose.yml and the app-specific compose files.

# ============================================
# DOCKER COMPOSE ISOLATION (multi-clone hosts)
# ============================================
# Clone principal: manter defaults abaixo.
# Worktrees/validação: use prefixo único (ex. rsv360-wt-validate).
COMPOSE_PROJECT_NAME=rsv360
RSV360_DOCKER_PROJECT=rsv360

# ============================================
# DATABASE CONFIGURATION
# ============================================
DB_HOST=postgres
DB_PORT=5432
# Volumes antigos do projeto usam rsv_360_ecosystem; installs novos podem usar rsv360.
# Apos clone: .\scripts\sync-postgres-docker-dev.ps1
DB_NAME=rsv_360_ecosystem
DB_USER=rsv360
# DEV ONLY: app-level password; use secret manager in production
DB_PASSWORD=rsv360_dev_2024
DATABASE_URL=postgresql://rsv360:rsv360_dev_2024@postgres:5432/rsv_360_ecosystem

# Container bootstrap values for `docker compose` / postgres image.
POSTGRES_USER=rsv360
# DEV ONLY: container bootstrap password; use secret manager in production
POSTGRES_PASSWORD=rsv360_dev_2024
POSTGRES_DB=rsv_360_ecosystem

# ============================================
# REDIS CONFIGURATION
# ============================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=true
# Filled in production via secret manager
REDIS_PASSWORD=

# ============================================
# JWT CONFIGURATION
# ============================================
JWT_SECRET=your_very_secure_jwt_secret_here_minimum_32_characters

# ============================================
# ADMIN AUTH
# ============================================
ADMIN_LOGIN_EMAIL=
ADMIN_LOGIN_PASSWORD=
ADMIN_JWT_SECRET=your_admin_jwt_secret_here_minimum_32_characters

# ============================================
# APP CONFIGURATION
# ============================================
NODE_ENV=development
PORT=3001
PORT_BACKEND=3002
PORT_SITE_PUBLICO=3000
PORT_TURISMO=3005
PORT_ADMIN=3004
PORT_GUEST=3006
NEXT_PUBLIC_API_URL=http://localhost:3002
NEXT_PUBLIC_BACKEND_URL=http://localhost:3002
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# marketing-lab: :3000 = lab; B2C em :5000 (S1 Crm-RSV-360)
RSV360_APP_MODE=marketing-lab
NEXT_PUBLIC_APP_MODE=marketing-lab
NEXT_PUBLIC_PRIMARY_SITE_URL=http://localhost:5000
NEXT_PUBLIC_LAB_TITLE=RSV360 Marketing Lab
NEXT_PUBLIC_TURISMO_URL=http://localhost:3005
NEXT_PUBLIC_ADMIN_URL=http://localhost:3004
NEXT_PUBLIC_GUEST_URL=http://localhost:3006
ENTERPRISE_DEFAULT_ID=ent_1

# ============================================
# GUEST PORTAL
# ============================================
PORTAL_BASE_URL=http://localhost:3000/portal
PORTAL_TOKEN_EXPIRY_DAYS=7

# ============================================
# HOUSEKEEPING
# ============================================
HK_AUTO_SCHEDULE_ENABLED=true
HK_AUTO_SCHEDULE_HOUR=6
HK_DEFAULT_TASK_MINUTES=30
HK_INSPECTION_REQUIRED=true
HK_MIN_INSPECTION_RATING=4

# ============================================
# REVENUE ENGINE
# ============================================
DEFAULT_BASE_PRICE=250.00
MIN_ROOM_PRICE=50.00
MAX_ROOM_PRICE=9999.00
REVENUE_CURRENCY=BRL
FORECAST_HISTORY_YEARS=3
RATE_CALENDAR_AUTO_GENERATE=true

# ============================================
# CRM & LOYALTY
# ============================================
CRM_DEFAULT_POINTS_PER_BRL=1.0
CRM_POINTS_EXPIRY_DAYS=365
CRM_LOYALTY_PROGRAM_NAME=RSV360 Fidelidade

# ============================================
# MULTI-PROPERTY
# ============================================
DEFAULT_PROPERTY_ID=1
MAX_PROPERTIES_PER_USER=10

# ============================================
# IA (CaldasAI + Copiloto) — Fase 1 migração
# ============================================
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_SYSTEM_PROMPT=Voce e o CaldasAI, assistente virtual da Reservei Viagens em Caldas Novas e Rio Quente.

# ============================================
# WhatsApp (Evolution API / WAAS) — Fase 1 migração
# ============================================
WAAS_API_URL=http://localhost:8080
WAAS_API_KEY=

# ============================================
# PRODUCTION SPECIFIC
# ============================================
# NODE_ENV=production (set in docker-compose.prod.yml)
# NODE_ENV=staging (set in docker-compose.staging.yml)

# ============================================
# SSL CERTIFICATES
# ============================================
# Place your SSL certificates in docker/nginx/ssl/
# - cert.pem (full chain certificate)
# - key.pem (private key)

# ============================================
# SECURITY NOTES
# ============================================
# - Use strong, unique passwords for all services
# - JWT_SECRET should be at least 32 characters
# - Store this file securely and never commit to version control
# - Use different values for staging and production

# ============================================
# COMMUNICATION - EMAIL (SMTP)
# ============================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="RSV360 <noreply@rsv360.dev>"
SMTP_SECURE=false

# ============================================
# AUTH — PASSWORD RESET E-MAIL (D2.8)
# ============================================
# URL base do site-publico (sem path); link gerado: {BASE}/redefinir-senha?token=…
PASSWORD_RESET_BASE_URL=http://localhost:3000
# Alternativa legada (mesmo efeito que PASSWORD_RESET_BASE_URL)
# PASSWORD_RESET_URL_BASE=
# Webhook HTTP (prioridade sobre SMTP) — payload JSON: to, name, resetUrl, subject, html, text
PASSWORD_RESET_EMAIL_WEBHOOK=
PASSWORD_RESET_EMAIL_WEBHOOK_SECRET=
PASSWORD_RESET_EMAIL_FROM=noreply@rsv360.dev
# SES via SMTP: SMTP_HOST=email-smtp.us-east-1.amazonaws.com + credenciais IAM SMTP

# ============================================
# AUTH — OAUTH SOCIAL (D2.9, site-publico BFF)
# ============================================
# Segredo compartilhado BFF ↔ backend (obrigatório em produção)
OAUTH_BFF_SECRET=
# Dev sem credenciais Google/Facebook: OAUTH_DEV_MOCK=true
OAUTH_DEV_MOCK=false

# ============================================
# AUTH — SSO S1↔S2 Marketing Lab (Fase 4)
# ============================================
# Segredo BFF ↔ backend para emitir códigos handoff (fallback: OAUTH_BFF_SECRET)
SSO_BFF_SECRET=
# Simula handoff do :5000 em dev: GET /api/auth/sso/dev-handoff
SSO_DEV_MOCK=true
# Exige JWT nas rotas lab (além de MARKETING_LAB_REQUIRE_AUTH no site-publico)
MARKETING_LAB_REQUIRE_AUTH=false
MARKETING_LAB_URL=http://localhost:3000
# Demo KPIs no dashboard se tabelas marketing_* ausentes (dev Docker)
LAB_METRICS_DEMO=true

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ============================================
# COMMUNICATION - SENDGRID (ALTERNATIVA SMTP)
# ============================================
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@rsv360.dev

# ============================================
# COMMUNICATION - TWILIO SMS
# ============================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ============================================
# COMMUNICATION - WHATSAPP BUSINESS
# ============================================
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
