# RSV360 Production Environment Variables
# Copy this file to .env.production and fill in your values

# ============================================
# DATABASE CONFIGURATION
# ============================================
POSTGRES_USER=rsv360_prod
POSTGRES_PASSWORD=your_secure_production_postgres_password_here
POSTGRES_DB=rsv360_prod_db
DATABASE_URL=postgresql://rsv360_prod:your_secure_production_postgres_password_here@postgres:5432/rsv360_prod_db

# ============================================
# REDIS CONFIGURATION
# ============================================
REDIS_PASSWORD=your_production_redis_password_here
REDIS_URL=redis://:your_production_redis_password_here@redis:6379

# ============================================
# JWT CONFIGURATION
# ============================================
JWT_SECRET=your_production_jwt_secret_here_minimum_32_characters

# ============================================
# FRONTEND CONFIGURATION
# ============================================
NEXT_PUBLIC_API_URL=https://rsv360.com/api/v1
NEXT_PUBLIC_BACKEND_URL=https://rsv360.com

# ============================================
# MONITORING CONFIGURATION
# ============================================
GRAFANA_ADMIN_PASSWORD=your_production_grafana_password

# ============================================
# DEPLOYMENT CONFIGURATION
# ============================================
NODE_ENV=production
PORT=3002