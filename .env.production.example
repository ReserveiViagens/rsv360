# RSV360 Production Environment Variables
# Copy to .env (or inject via secret manager) before: docker compose up -d --build
# NEVER commit real secrets.

# ============================================
# CORE
# ============================================
NODE_ENV=production
COMPOSE_PROJECT_NAME=rsv360
RSV360_DOCKER_PROJECT=rsv360

POSTGRES_USER=rsv360_prod
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD
POSTGRES_DB=rsv360_prod_db
DATABASE_URL=postgresql://rsv360_prod:CHANGE_ME_STRONG_POSTGRES_PASSWORD@postgres:5432/rsv360_prod_db

# ============================================
# REDIS — Cotação v2 (cache PR 4 + lock PR 5 + filas BullMQ)
# ============================================
# Obrigatório em produção: NÃO definir REDIS_DISABLED.
# Compose interno: redis://redis:6379 | Managed (ElastiCache etc.): rediss://user:pass@host:6379
REDIS_URL=redis://redis:6379
# openssl rand -hex 32 — mesma chave em todas as réplicas do backend
FORNECEDORES_ENCRYPTION_KEY=CHANGE_ME_32_CHARS_MIN_FORNECEDORES_KEY

JWT_SECRET=CHANGE_ME_JWT_SECRET_MIN_32_CHARS
JWT_REFRESH_SECRET=

# HTTP security headers (PR-05a)
# Set true only when the edge terminates TLS (VPS/prod). No preload.
# Leave false until that wave — browsers cache HSTS aggressively.
ENABLE_HSTS=false

# PR-05b — CORS allowlist (prod origins) + Prometheus scrape bearer
CORS_ORIGIN=https://www.reserveiviagens.com.br,https://admin.reserveiviagens.com.br
METRICS_TOKEN=CHANGE_ME_METRICS_TOKEN_MIN_32_CHARS

# ============================================
# SITE PÚBLICO (URL canônica — OAuth + reset links)
# ============================================
NEXT_PUBLIC_SITE_URL=https://www.reserveiviagens.com.br
NEXT_PUBLIC_API_URL=https://www.reserveiviagens.com.br
NEXT_PUBLIC_BACKEND_URL=https://api.reserveiviagens.com.br

# ============================================
# AUTH — OAUTH BFF (D2.9) — OBRIGATÓRIO PRODUÇÃO
# ============================================
# Mesmo valor em backend E site-publico. Gere: openssl rand -hex 32
OAUTH_BFF_SECRET=CHANGE_ME_OAUTH_BFF_SECRET
OAUTH_DEV_MOCK=false

# Google Cloud Console → OAuth 2.0 Client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://www.reserveiviagens.com.br/api/auth/google/callback

# Meta for Developers → Facebook Login
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=https://www.reserveiviagens.com.br/api/auth/facebook/callback

# ============================================
# AUTH — PASSWORD RESET E-MAIL (D2.8 / PR-16a) — backend
# ============================================
# Obrigatório em produção (fail-closed). Cadeia:
#   PASSWORD_RESET_BASE_URL → NEXT_PUBLIC_PRIMARY_SITE_URL | PRIMARY_SITE_URL
# FRONTEND_URL não é usado para links de reset.
PASSWORD_RESET_BASE_URL=https://www.reserveiviagens.com.br
PASSWORD_RESET_EMAIL_FROM=noreply@reserveiviagens.com.br

# Opção A: Webhook (prioridade)
PASSWORD_RESET_EMAIL_WEBHOOK=
PASSWORD_RESET_EMAIL_WEBHOOK_SECRET=

# Opção B: SMTP / Amazon SES SMTP
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Reservei Viagens <noreply@reserveiviagens.com.br>"
SMTP_SECURE=false

# ============================================
# MONITORING (opcional)
# ============================================
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA
