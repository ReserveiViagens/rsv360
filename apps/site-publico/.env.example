# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rsv360
DB_USER=postgres
DB_PASSWORD=

# API Configuration
# NEXT_PUBLIC_* is embedded at `next build` — set as Docker build-arg in staging/prod.
NEXT_PUBLIC_API_URL=http://localhost:3002
# Server-side BFF + /uploads rewrite (runtime on Next server; preferred for vitrine images)
INTERNAL_API_URL=http://localhost:3002

# Mercado Pago (Split Marketplace)
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_WEBHOOK_SECRET=

# OpenAI (IA: classificação despesas, sugestão split, chat tributário)
OPENAI_API_KEY=

# Google Maps (opcional)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Environment
NODE_ENV=development

# Site URL (OAuth callbacks + links reset) — URL deste app (:3000 = lab)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
BACKEND_INTERNAL_URL=http://localhost:3002

# Roteiro Inteligente — PR B: ligar em dev (preview + proposta usam o mesmo motor)
ROTEIRO_INTELIGENTE_ENABLED=true

# Cloudflare Turnstile — chaves de teste (dev)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Rate limit proposta — dev folgado
PROPOSTA_SUCCESS_COOLDOWN_MS=0
PROPOSTA_ATTEMPT_DEBOUNCE_MS=0

# Modo app: public | marketing-lab (coexistência com S1)
# Voltar S1 (canal=s1-hoteis) → NEXT_PUBLIC_PRIMARY_SITE_URL/hoteis.
# Em VPS/prod: setar o domínio real do S1 no compose — default localhost:5000 só vale no lab.
RSV360_APP_MODE=marketing-lab
NEXT_PUBLIC_APP_MODE=marketing-lab
NEXT_PUBLIC_PRIMARY_SITE_URL=http://localhost:5000
NEXT_PUBLIC_LAB_TITLE=RSV360 Marketing Lab
# Demo KPIs se tabelas marketing_* ausentes (default dev)
LAB_METRICS_DEMO=true

# OAuth BFF (mesmo segredo no backend — ver .env raiz)
OAUTH_BFF_SECRET=
OAUTH_DEV_MOCK=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:3000/api/auth/facebook/callback

# JWT (fail-closed — required for BFF / WS / auth routes)
JWT_SECRET=CHANGE_ME_JWT_SECRET_MIN_32_CHARS
# Optional in PR-04a — inherits JWT_SECRET if empty (separation → PR-04b)
JWT_REFRESH_SECRET=

# Admin Auth (JWT)
ADMIN_JWT_SECRET=CHANGE_ME_ADMIN_JWT_SECRET_MIN_32_CHARS
ADMIN_LOGIN_PASSWORD=
ADMIN_LOGIN_EMAIL=admin@rsv360.local

# HTTP security headers (PR-05a) — HSTS only with TLS; never on local HTTP
ENABLE_HSTS=false

# PR-05b — CORS allowlist (shared with backend Socket.IO) + metrics bearer
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3004,http://localhost:3005,http://localhost:3006,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:3004,http://127.0.0.1:3005,http://127.0.0.1:3006
METRICS_TOKEN=CHANGE_ME_METRICS_TOKEN_MIN_32_CHARS
