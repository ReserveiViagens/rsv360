# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rsv360
DB_USER=postgres
DB_PASSWORD=

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:5000

# Mercado Pago (Split Marketplace)
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=

# OpenAI (IA: classificação despesas, sugestão split, chat tributário)
OPENAI_API_KEY=

# Google Maps (opcional)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Environment
NODE_ENV=development

# Site URL (OAuth callbacks + links reset)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
BACKEND_INTERNAL_URL=http://localhost:3002

# OAuth BFF (mesmo segredo no backend — ver .env raiz)
OAUTH_BFF_SECRET=
OAUTH_DEV_MOCK=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:3000/api/auth/facebook/callback

# Admin Auth (JWT)
ADMIN_JWT_SECRET=
ADMIN_LOGIN_PASSWORD=
ADMIN_LOGIN_EMAIL=admin@rsv360.local
